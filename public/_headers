# Response headers for Cloudflare (Netlify reads the same file).
# The bundle carries a content hash in its name: browsers may keep it for good. Everything else (world maps,
# textures, models) keeps the default behaviour, revalidated on each visit, so that a new version of the
# world is never mixed with files of the previous one.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable
# The page itself is never kept: a browser always asks whether there is a newer one (a new version of the game
# is a new page that names new bundles). Nor is the small file that says which version is online.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
# The back office: a page of plain files that asks everything of the API with a key. It loads nothing from
# anywhere else, runs no script but its own, is never framed, never kept and never listed.
/admin/*
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
