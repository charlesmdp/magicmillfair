{
  "name": "magic-mill-fair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An explorable 3D world in the browser: an old mill, its valley between the mountains and a grand pier by the sea.",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "bake": "npm run bake:world && npm run bake:statue && npm run bake:textures",
    "bake:world": "node tools/bake-world.mjs",
    "bake:statue": "node tools/bake-statue.mjs",
    "bake:textures": "node tools/bake-textures.mjs",
    "test": "node tools/net-test.mjs",
    "test:cf": "node tools/net-test.mjs --cloudflare",
    "test:smoke": "node tools/smoke.mjs",
    "test:walk": "node tools/walk-test.mjs",
    "test:duo": "node tools/duo.mjs",
    "test:audio": "node tools/audio-test.mjs",
    "test:shop": "node tools/shop-test.mjs",
    "bench": "node tools/bench.mjs",
    "profile": "node tools/profile.mjs",
    "shots": "node tools/shots.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "sharp": "^0.35.5"
  }
}
