// Cloudflare deployment. Connect this repository in the Cloudflare dashboard (Workers & Pages → import a
// repository) and keep the default deploy command, `npx wrangler deploy`: it builds the site, then publishes
// the site, the Worker and the multiplayer rooms. Every push redeploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must be the name of the Worker in the dashboard (which proposes the repository name).
  "name": "magicmillfair",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  // Runs before every deploy: produces dist/.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only these paths run the Worker; the files of the site are served directly.
    "run_worker_first": ["/ws", "/api/*", "/healthz"]
  },
  // One Durable Object per multiplayer room, plus one that keeps the leaderboards (see cloudflare/worker.js).
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // A variable added in the dashboard (the Worker → Settings → Variables and Secrets) stays there when the game is
  // delivered again: without this line every delivery would take away what is not written below.
  "keep_vars": true,
  "vars": {
    // How many visitors a room holds before the next ones gather in another (each is told in detail about
    // the forty nearest: see server/protocol.js).
    "MAX_PLAYERS": "200",
    "TICK_MS": "100",
    // Comma separated origins allowed to open the multiplayer socket. Empty: the site's own address only.
    "ALLOWED_ORIGINS": "",
    // The address the game writes from (a code to set a new password, a welcome, a thank you): an address of
    // the domain that was onboarded to Cloudflare's Email Service. Not a secret — the two that go with it are
    // (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_EMAIL_TOKEN: below).
    "MAIL_FROM": "hello@atomicoasis.io"
    // Secrets are NOT written here: add them in the dashboard (the Worker → Settings → Variables and
    // Secrets → Add → type "Secret"), or with `npx wrangler secret put NAME`:
    //   ANTHROPIC_API_KEY  Billy the alligator then answers through Claude (NPC_MODEL, a variable, picks the model)
    //   ADMIN_KEY          the administrator's key: a long password of your own (`/admin <key>` in the chat)
    //   SCORE_SECRET       optional: signs the notes of the game runs (drawn and kept by the Worker otherwise)
    //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET   open the shop (sk_test_… to try, sk_live_… to sell): see the README, "The shop"
    //   STRIPE_PUBLISHABLE_KEY   optional (pk_test_… / pk_live_…): the payment form is then shown inside the game
    //   CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_EMAIL_TOKEN   optional: with MAIL_FROM above, the game can then send an
    //                      e-mail (a code to set a new password, a welcome, a thank you — to accounts that gave an
    //                      address): see the README, "E-mails"
    // https://<the site>/api/status tells which of them the Worker sees (true / false, never their value).
  },
  // (E-mails need nothing here: the three secrets above are enough. A binding
  //   "send_email": [{ "name": "EMAIL" }],
  // is used instead of the token when it is there — add it only once the domain is onboarded to Cloudflare's
  // Email Service: a binding the account cannot honour makes a deployment fail.)
  "observability": { "enabled": true },
  // No usage statistics sent to Cloudflare by the tool itself.
  "send_metrics": false
}
