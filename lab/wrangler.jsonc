// The lab as a site of its own on Cloudflare, with its server: multiplayer, the administrator, the leaderboards —
// nothing shared with the game that is online (another Worker, other rooms, another notebook).
//
// In the Cloudflare dashboard: Workers & Pages → Create → Import a repository → this repository, then
//   branch            the lab's branch
//   deploy command    npx wrangler deploy --config lab/wrangler.jsonc
// and, once it is deployed, Settings → Variables and Secrets → Add → type "Secret":
//   ADMIN_KEY         a long password of your own (then `/admin <that password>` in the chat of the lab)
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Must be the name of the Worker in the dashboard.
  "name": "magicmillfair-lab",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Runs before every deploy, from where the deploy command is run (the root of the repository): the game and
  // the lab pages, into dist/.
  "build": { "command": "npx vite build --config lab/vite.config.js" },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*", "/healthz"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": { "MAX_PLAYERS": "250", "TICK_MS": "100", "ALLOWED_ORIGINS": "" },
  "observability": { "enabled": true },
  "send_metrics": false
}
